<div class="hypertable-summary" ...attributes>
  <span class="hypertable-summary__title" data-control-name="hypertable_summary_title">{{this.title}}</span>
  <div class="hypertable-summary__container">
    {{#if @loading}}
      {{#each this.skeletons}}
        <div class="hypertable-summary__loading-container" data-control-name="hypertable_summary_skeleton">
          <OSS::Skeleton @height={{14}} @width={{70}} />
          <OSS::Skeleton @height={{14}} @width={{14}} />
        </div>
      {{/each}}
    {{else}}
      {{#each @fields as |field|}}
        <div class="hypertable-summary__stat" data-control-name="hypertable_summary_stat">
          <span data-control-name="hypertable_summary_stat_label">{{field.label}}</span>
          {{#if field.tooltip}}
            <OSS::Icon
              @style="solid"
              @icon="fa-info-circle"
              class="hypertable-summary__tooltip"
              data-control-name="hypertable_summary_stat_tooltip"
              {{enable-tooltip title=field.tooltip placement="top"}}
            />
          {{/if}}
          <span data-control-name="hypertable_summary_stat_value">{{field.value}}</span>
        </div>
      {{/each}}
    {{/if}}
  </div>
</div>