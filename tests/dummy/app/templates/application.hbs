<div class="padding-px-12 fx-col fx-gap-px-6">
  <div class="fx-row fx-gap-px-6 fx-xalign-center">
    <span>Change selected creator:</span>
    <OSS::NumberInput @value={{this.selectedValue}} @min={{0}} @max={{5}} @onChange={{this.updateSelected}} />
    <span>Loading animations:</span>
    <OSS::ToggleSwitch @value={{this.animationsEnabled}} @onChange={{this.toggleAnimations}} />
    <OSS::Button @label="Prepend rows" @icon="fa-plus" {{on "click" this.prependRows}} />
    <OSS::Button @label="Reset rows" @icon="fa-refresh" {{on "click" this.resetRows}} />
  </div>
  <div class="hypertable-container">
    <HyperTableV2::Selection
      @selected={{this.selectedValue}}
      @total={{5}}
      @onClear={{this.onClear}}
      @onSelectAll={{this.onSelectAll}}
    />
  </div>
</div>

<div class="padding-px-12">
  <HyperTableV2 @handler={{this.handler}} @options={{this.tableOptions}}>
    <:contextual-actions>
      {{! To do : move contextual-actions CSS to the target component }}
      <div class="contextual-actions contextual-actions--visible">
        <div class="fx-row fx-row fx-gap-px-10">
          <OSS::Badge @icon="fas fa-box-open" />
          <OSS::Badge @size="md" @icon="fas fa-box-open" />
        </div>
      </div>
    </:contextual-actions>
  </HyperTableV2>
</div>

<div class="padding-px-12 fx-col fx-gap-px-6">
  <div class="fx-row fx-gap-px-6 fx-xalign-center">
    <span>Summary loading:</span>
    <OSS::ToggleSwitch @value={{this.summaryLoading}} @onChange={{this.toggleSummaryLoading}} />
  </div>
  <HyperTableV2::Summary @loading={{this.summaryLoading}} @fields={{this.summaryFields}} />
</div>